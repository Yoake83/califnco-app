{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/core/src/**/*.ts",
    "apps/mobile/scripts/**/*.ts",
    "apps/admin/server/**/*.ts",
    "apps/admin/api/**/*.ts"
  ]
}
