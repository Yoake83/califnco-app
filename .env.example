# Optional for a trusted local order server. Leave empty to use Application Default Credentials.
# This is a server credential, not the public google-services.json or web app configuration.
FIREBASE_SERVICE_ACCOUNT_JSON=
APP_ORIGINS=http://localhost:8081,http://localhost:5174
COMMERCE_PORT=3001
# Razorpay TEST keys only; server secrets must never use public prefixes.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
